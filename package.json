{
  "name": "worbik",
  "version": "1.0.0",
  "description": "",
  "author": "Drake Costa <drake@saeris.io>",
  "license": "ISC",
  "keywords": [],
  "packageManager": "yarn@3.6.3",
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*.js",
      "./src/*.jsx",
      "./src/*/index.ts",
      "./src/*/index.tsx",
      "./src/*/index.js",
      "./src/*/index.jsx"
    ]
  },
  "scripts": {
    "lint": "next lint",
    "format": "yarn test:lint --fix",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "yarn test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ariakit/react": "^0.2.17",
    "@supabase/supabase-auth-helpers": "^1.4.2",
    "@supabase/supabase-js": "^2.33.1",
    "@vercel/analytics": "^1.0.2",
    "@vercel/edge-config": "^0.2.1",
    "class-variance-authority": "^0.7.0",
    "date-fns": "^2.30.0",
    "next": "13.4.19",
    "next-pwa": "5.6.0",
    "next-themes": "^0.2.1",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.10.1",
    "zod": "3.22.2"
  },
  "devDependencies": {
    "@saeris/eslint-config": "^2.5.0",
    "@types/jest": "^29.5.4",
    "@types/node": "18.17.11",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.48.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jest": "^27.2.3",
    "jest": "^29.6.4",
    "postcss": "^8.4.28",
    "postcss-load-config": "^4.0.1",
    "postcss-nested": "^6.0.1",
    "postcss-preset-env": "^9.1.1",
    "prettier": "^3.0.2",
    "turbo": "^1.10.13",
    "typescript": "5.2.2",
    "typescript-plugin-css-modules": "^5.0.1"
  },
  "eslintConfig": {
    "extends": [
      "@saeris/eslint-config/base",
      "@saeris/eslint-config/react",
      "@saeris/eslint-config/next",
      "@saeris/eslint-config/jest",
      "@saeris/eslint-config/typescript",
      "@saeris/eslint-config/type-aware"
    ],
    "ignorePatterns": [
      ".next/**/*",
      "*.js",
      "*.cjs",
      "*.mjs",
      "*.d.ts"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "bracketSpacing": true,
    "jsxBracketSameLine": false
  }
}
